# resolix.service — systemd unit for Resolix
#
# Installation:
#   1. Install the Resolix binary at /usr/bin/resolix and entrypoint.sh at
#      /usr/local/libexec/resolix/entrypoint.sh (mode 0755).
#   2. Copy this file to /etc/systemd/system/resolix.service.
#   3. Copy the environment file to /etc/default/resolix
#      (see .env.example for available variables).
#   4. Install Tailscale; DNS is served by Resolix itself.
#   5. Reload systemd:  sudo systemctl daemon-reload
#   6. Enable at boot:  sudo systemctl enable resolix
#   7. Start now:       sudo systemctl start resolix
#
# Usage:
#   sudo systemctl status resolix   # Check status
#   sudo journalctl -u resolix -f   # Follow logs
#   sudo systemctl restart resolix  # Restart service
#
[Unit]
Description=Resolix DNS control plane
Wants=network-online.target
After=network-online.target
Documentation=https://github.com/arumes31/resolix

[Service]
Type=simple
# Read the former environment location first to preserve in-place upgrades;
# values in the Resolix environment file take precedence when both exist.
EnvironmentFile=-/etc/default/tailscale-dnsrewrite
EnvironmentFile=-/etc/default/resolix
ExecStart=/usr/local/libexec/resolix/entrypoint.sh
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
RuntimeDirectory=tailscale
StateDirectory=tailscale resolix tailscale-dnsrewrite

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tailscale /var/lib/resolix /var/lib/tailscale-dnsrewrite /var/run/tailscale
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=resolix

[Install]
WantedBy=multi-user.target
